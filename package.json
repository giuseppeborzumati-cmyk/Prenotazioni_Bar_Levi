{
  "name": "intervallo-bar-levi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/domain.test.ts tests/worker.test.ts tests/excel.test.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "roles": "node scripts/set-role.mjs",
    "firebase:seed": "node --import tsx scripts/seed-firebase.ts",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src shared worker scripts tests *.json *.ts docs README.md",
    "dev:demo": "vite --host 0.0.0.0 --mode demo",
    "build:demo": "tsc -b && vite build --mode demo"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agent-browser": "^0.38.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^13.35.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
